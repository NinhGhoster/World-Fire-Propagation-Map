# World Fire Propagation Map - Environment Configuration
# Copy this file to .env and fill in your values

# NASA FIRMS API Key - Get from https://firms.modaps.eosdis.nasa.gov/api/area/
FIRMS_API_KEY=your_api_key_here

# Application Settings
FLASK_ENV=development
DEBUG=false
LOG_LEVEL=INFO

# Azure Application Settings (if deploying to Azure)
# AZURE_STORAGE_CONNECTION_STRING=your_connection_string
# AZURE_STORAGE_CONTAINER=fire-maps
