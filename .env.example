# World Fire Propagation Map - Environment Configuration
# Copy this file to .env and fill in your values

# Application Settings
DEBUG=false
HOST=0.0.0.0
PORT=8050

# NASA FIRMS API Key (get from https://firms.modaps.eosdis.nasa.gov/api/accounts/register/)
FIRMS_API_KEY=your_api_key_here

# Logging
LOG_LEVEL=INFO

# Optional: Database (for production)
# DATABASE_URL=postgresql://user:password@localhost:5432/firemap

# Optional: Redis (for caching)
# REDIS_URL=redis://localhost:6379

# API Keys for external services
# WEATHER_API_KEY=your_weather_api_key
# MAPBOX_TOKEN=your_mapbox_token
